# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-audit/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# local screenshots and scratch pages
/shots/
.tmp-page.html

# Source masters and recovery archives. The site serves the web encodes in
# pages.json; the full-size originals are too large for git (one is 210 MB,
# over GitHub's 100 MB blob limit).
/media-source/
/public/projects/highstreet-calamity-vr/sections/01-gesture-casting-and-ability-design/gesture-casting-demo.mp4

# One-off audit and verification output. No source file reads any of it.
/content/portfolio/verification/
/content/portfolio/asset-audit/
/ASSET-AUDIT.html
/ASSET-AUDIT.md
/MEDIA-REVIEW.html

# Featured-work editor: runs only under next dev and writes
# content/portfolio/featured-layout.json, which is committed.
/src/app/dev/
/src/app/api/dev/
/src/components/portfolio/featured-editor.tsx
/src/components/portfolio/featured-editor.css
/content/portfolio/FEATURED-WORK.md

# Media cleanup working notes. No source file reads them.
/content/portfolio/media-cleanup.json
/content/portfolio/media-folders.json
